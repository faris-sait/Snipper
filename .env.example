# Public site URL — used in OG tags and shareable URLs. Set to your prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 4 (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — DO NOT expose. Used by route handlers to write audits/leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4 (Resend) ---
RESEND_API_KEY=
# The "From" address must be verified in Resend.
RESEND_FROM_EMAIL=

# --- Phase 5 (Gemini) ---
# Get a free key at aistudio.google.com → Get API Key.
GEMINI_API_KEY=

# --- Phase 1 Round 2 (admin endpoints) ---
# Bearer token for POST /api/admin/pricing and POST /api/detect-changes.
# Generate with `openssl rand -hex 32`. Set the same value in Vercel + GitHub Secrets.
ADMIN_TOKEN=

# --- Optional: rate limit (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
