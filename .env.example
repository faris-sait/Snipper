# Public site URL — used in OG tags and shareable URLs. Set to your prod URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 4 (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — DO NOT expose. Used by route handlers to write audits/leads.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phase 4 (Resend) ---
RESEND_API_KEY=
# The "From" address must be verified in Resend.
RESEND_FROM_EMAIL=

# --- Phase 5 (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Optional: rate limit (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
