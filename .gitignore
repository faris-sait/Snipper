# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent-browser / skills dev tooling — install state and generated output, not source.
# skills-lock.json is intentionally NOT ignored; it's the reproducibility lockfile.
.agents/
.claude/
dogfood-output/
.env*.local

# vendored clone of heygen-com/hyperframes for local reference; not part of Snipper.
hyperframes/

# hyperframes render artifacts — composition source is committed under video/, output is regenerable.
video/**/output.mp4
video/**/dist/
